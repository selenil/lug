---
version: 2.0.0
title: compiler__table_with_list_and_record_fields
---
return { 1, 2, a = true, b = false }

------------------------------

function main(...) --from line 1 to line 1
    NEWTABLE to: 1, hash_count: 2, array_count: 2
    LOADCONSTANT in: 2, constant: 1
    LOADCONSTANT in: 3, constant: 2
    SETLIST table: 1, length: 2
    LOADCONSTANT in: 4, constant: true
    LOADCONSTANT in: 5, constant: "a"
    SETTABLE table: 1, key: 5, value: 4
    LOADCONSTANT in: 6, constant: false
    LOADCONSTANT in: 7, constant: "b"
    SETTABLE table: 1, key: 7, value: 6
    RETURN starting: 1, count: 1
end
