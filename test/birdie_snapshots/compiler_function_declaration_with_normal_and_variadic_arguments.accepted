function concat(x, ...) return x end

------------------------------

function main(...) --from line 1 to line 1
    CLOSURE to: 1, prototype_index: 0
    SETGLOBAL name: concat, to: 1
end

function concat(_, ...) --from line 1 to line 1
    VARARGPREP arg_count: 1
    RETURN starting: 1, count: 1
end
