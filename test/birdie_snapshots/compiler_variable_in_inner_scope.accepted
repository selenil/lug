title: compiler__variable_in_inner_scope
---
a = 'outer'
do
  local a = 'inner'
  return a
end

------------------------------

function main(...) --from line 1 to line 5
    LOADCONSTANT in: 1, constant: "outer"
    SETGLOBAL name: a, to: 1
    LOADCONSTANT in: 2, constant: "inner"
    RETURN starting: 2, count: 1
end
