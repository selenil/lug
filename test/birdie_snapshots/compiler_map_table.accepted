---
version: 2.0.0
title: compiler__map_table
---
return { a = 1, b = 2, c = 3 }

------------------------------

function main(...) --from line 1 to line 1
    NEWTABLE to: 1, hash_count: 3, array_count: 0
    LOADCONSTANT in: 2, constant: 1
    LOADCONSTANT in: 3, constant: "a"
    SETTABLE table: 1, key: 3, value: 2
    LOADCONSTANT in: 4, constant: 2
    LOADCONSTANT in: 5, constant: "b"
    SETTABLE table: 1, key: 5, value: 4
    LOADCONSTANT in: 6, constant: 3
    LOADCONSTANT in: 7, constant: "c"
    SETTABLE table: 1, key: 7, value: 6
    RETURN starting: 1, count: 1
end
