version: 2.0.0
title: compiler__function_call_with_another_call_as_last_argument
---
return fun(a, b, other(c))

------------------------------

function main(...) --from line 1 to line 1
    GETGLOBAL to: 1, name: fun
    GETGLOBAL to: 2, name: a
    GETGLOBAL to: 3, name: b
    GETGLOBAL to: 4, name: other
    GETGLOBAL to: 5, name: c
    CALL function: 4, arg_count: 1, result_count: -1
    CALL function: 1, arg_count: -1, result_count: -1
    RETURN starting: 1, count: -1
end
