function M.some_table.some_field:method() return true end

------------------------------

function main(...) --from line 1 to line 1
    GETGLOBAL to: 2, name: M
    MOVE to: 3, from: 2
    LOADCONSTANT in: 4, constant: "some_table"
    GETTABLE to: 3, table: 3, index: 4
    LOADCONSTANT in: 4, constant: "some_field"
    GETTABLE to: 3, table: 3, index: 4
    CLOSURE to: 1, prototype_index: 0
    LOADCONSTANT in: 4, constant: "method"
    SETTABLE table: 3, key: 4, value: 1
end

function M.some_table.some_field.method(_) --from line 1 to line 1
    LOADCONSTANT in: 2, constant: true
    RETURN starting: 2, count: 1
end
