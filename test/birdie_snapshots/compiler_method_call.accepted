    LOADCONSTANT in: 2, constant: "method"
    GETTABLE to: 3, table: 1, index: 2
    GETGLOBAL to: 7, name: obj
    GETGLOBAL to: 8, name: a
    GETGLOBAL to: 9, name: b
    MOVE to: 4, from: 7
    MOVE to: 5, from: 8
    MOVE to: 6, from: 9
    CALL function: 3, arg_count: 3, result_count: -1
end
