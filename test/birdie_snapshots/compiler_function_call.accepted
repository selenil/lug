return fun(a, b)

------------------------------

function main(...) --from line 1 to line 1
    GETGLOBAL to: 1, name: fun
    GETGLOBAL to: 2, name: a
    GETGLOBAL to: 3, name: b
    CALL function: 1, arg_count: 2, result_count: -1
    RETURN starting: 1, count: -1
end
