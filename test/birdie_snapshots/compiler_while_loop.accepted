---
version: 2.0.0
title: compiler__while_loop
---
while a < 5 do a = a + 1 end

------------------------------

function main(...) --from line 1 to line 1
    loop
        GETGLOBAL to: 2, name: a
        LOADCONSTANT in: 3, constant: 5
        LT to: 1, left: 2, right: 3
        GETGLOBAL to: 5, name: a
        LOADCONSTANT in: 6, constant: 1
        ADD to: 4, left: 5, right: 6
        SETGLOBAL name: a, to: 4
    until has_truthy: 1
end
